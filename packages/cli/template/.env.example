# ============================================================
# Bitcoin Meetup Website - Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# Only a database and BETTER_AUTH_SECRET are required to start.
# All integrations are optional and degrade gracefully when missing.

# ── Required ──────────────────────────────────────────────────
POSTGRES_URL=                          # PostgreSQL connection string. Vercel Postgres sets this automatically.
BETTER_AUTH_SECRET=                    # Random secret for auth sessions (generate with: openssl rand -base64 32)

# ── Email (Resend) — optional ────────────────────────────────
# Enables: newsletter subscriptions, contact form emails, email verification
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ── Payments (Zaprite) — optional ─────────────────────────────
# Enables: Bitcoin/Lightning donation checkout
ZAPRITE_API_KEY=

# ── Meetup.com — optional ────────────────────────────────────
# Enables: event sync with Meetup.com group
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
MEETUP_OAUTH_TOKEN=
MEETUP_OAUTH_REFRESH_TOKEN=

# ── Notifications — optional (choose one) ───────────────────
# Set provider in site.config.ts → notifications.provider
#
# Telegram (recommended):
TELEGRAM_BOT_TOKEN=                    # Create a bot via @BotFather on Telegram
TELEGRAM_CHAT_ID=                      # Your group/channel chat ID
#
# Slack (alternative):
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ── Google Maps — optional ───────────────────────────────────
# Enables: interactive Bitcoin merchant map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Vercel Blob — optional ───────────────────────────────────
# Enables: media/image uploads in admin panel
BLOB_READ_WRITE_TOKEN=

# ── Site URL — optional ──────────────────────────────────────
# Set in production. Defaults to Vercel's auto-detected URL.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
